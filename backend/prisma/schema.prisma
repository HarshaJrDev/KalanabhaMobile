// Prisma schema — field names deliberately mirror the mobile app's `users` /
// `shipments` / `shipments/{id}/messages` / `notifications` / `vehicleConfigs`
// Firestore collections (see Screens/**, hooks/**, admin/KalanabhaAdmin/src/App.tsx)
// so the REST contracts need no client-side remapping during backend cut-over.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  DRIVER
  ADMIN
  DISPATCHER
  WAREHOUSE
}

enum ShipmentStatus {
  SEARCHING
  ACCEPTED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

// Single table for customers, drivers, and admins — matches the mobile app's
// single `users` Firestore collection, distinguished only by `role`.
// (Screens/AuthScreens/Signup.tsx, Login.tsx, components/DriverHeader.tsx,
// admin App.tsx CreateDriverModal)
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole

  displayName String?
  phone       String?
  address     String?
  // 'HOME' | 'BUSINESS' — Screens/AuthScreens/Signup.tsx UserTypeSelector
  customerType String?

  // Driver-only fields (admin App.tsx CreateDriverModal / Driver interface)
  isOnline          Boolean  @default(false)
  fcmToken          String?
  vehicleType       String?
  licenseNumber     String?
  rating            Float?
  totalDeliveries   Int      @default(0)
  documentsVerified Boolean  @default(false)
  createdByAdmin    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipmentsAsCustomer Shipment[]     @relation("CustomerShipments")
  shipmentsAsDriver   Shipment[]     @relation("DriverShipments")
  refreshTokens       RefreshToken[]
  chatMessages        ChatMessage[]
  notifications       Notification[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

// Mirrors shipment/types.ts + admin App.tsx's Shipment interface.
// sender/receiver/package/dispatch kept as JSON since the mobile app treats
// them as free-form nested objects (OrderDetails/Package/Receiver/sender
// screens) rather than fixed columns.
model Shipment {
  id         String @id @default(uuid())
  shipmentId String @unique
  trackingId String @unique

  customerId String
  customer   User   @relation("CustomerShipments", fields: [customerId], references: [id])

  driverId String?
  driver   User?   @relation("DriverShipments", fields: [driverId], references: [id])

  goodsType String
  weightKg  Float

  pickupAddress String
  pickupLat     Float
  pickupLng     Float

  dropAddress String
  dropLat     Float
  dropLng     Float

  price      Float
  distanceKm Float

  // Denormalized route strings used by the admin dashboard's list/search view
  from String
  to   String

  sender   Json
  receiver Json
  package  Json
  // { driverId, driverName, driverPhone?, driverRating?, acceptedAt?,
  //   startedAt?, completedAt?, assignedByAdmin?, assignedAt? }
  dispatch Json?

  serviceType String
  vehicleType String
  paymentMode String
  pickupSlot  String
  notes       String?

  status ShipmentStatus @default(SEARCHING)

  expiresAt   DateTime?
  etaMinutes  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]
}

model ChatMessage {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id])
  senderName String
  text       String
  createdAt  DateTime @default(now())
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  type       String?
  shipmentId String?
  title      String
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// Mirrors admin App.tsx's VehicleConfig interface — doubles as both the
// "logistics requirements" (max weight/dimensions/special conditions) and
// pricing (baseRate/ratePerKm) source for a given vehicle type.
model VehicleConfig {
  id                String   @id @default(uuid())
  name              String
  icon              String
  maxWeight         Float
  maxLength         Float
  maxWidth          Float
  maxHeight         Float
  maxVolume         Float
  baseRate          Float
  ratePerKm         Float
  specialConditions String[]
  active            Boolean  @default(true)
  color             String
  updatedAt         DateTime @updatedAt
}
